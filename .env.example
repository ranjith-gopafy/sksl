# =============================================
# SKSL — Environment Configuration Template
# Copy this file to .env and fill in values.
# NEVER commit .env to Git.
# =============================================

# Application
# These defaults are safe for a live server. For local development change them to:
#   APP_ENV=local   APP_DEBUG=true   APP_URL=http://localhost/sksl/public   SESSION_SECURE=false
# APP_ENV must be exactly "local" or "testing" for development; anything else (including typos) is treated as production.
# APP_URL must be your real https address in production; it is used for every link in emails.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Kolkata
# Reserved for future signed tokens; not read by the current code (CSRF/OTP/reset
# tokens are random per-session / per-row values). Still set a random value.
APP_SECRET=change-this-to-a-random-secret-string

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sksl
DB_USERNAME=root
DB_PASSWORD=

# Razorpay
# Use test credentials locally. Use production only after go-live approval.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP / Email
# MAIL_DRIVER: smtp | log. Leave empty to use smtp when SMTP_HOST is set.
# "log" writes full messages to storage/logs/mail.log for local development only —
# it is refused in production (recorded as failed in email_logs, nothing written).
MAIL_DRIVER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
# Required for smtp: the verified sender address (falls back to SMTP_USERNAME if it is an email)
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SKSL

# Admin notification email (required — booking alerts and refund flags go here)
ADMIN_EMAIL=

# =============================================
# Business identity — printed on GST TAX INVOICES, emails, contact page.
# Copy these EXACTLY from the GST registration certificate.
# In production, invoices are refused until BUSINESS_GSTIN, BUSINESS_ADDRESS_LINE1
# and BUSINESS_PINCODE are set. Locally, missing values produce a SPECIMEN watermark.
# =============================================
BUSINESS_LEGAL_NAME="Sara Kinetic Sports Lab"
BUSINESS_TRADE_NAME="Sara Kinetic Sports Lab"
BUSINESS_TAGLINE="Recover. Recharge. Perform."
# 15 characters, e.g. 29ABCDE1234F1Z5 (29 = Karnataka)
BUSINESS_GSTIN=
BUSINESS_STATE=Karnataka
BUSINESS_STATE_CODE=29
BUSINESS_ADDRESS_LINE1=
BUSINESS_ADDRESS_LINE2=
BUSINESS_CITY=Bengaluru
BUSINESS_PINCODE=
BUSINESS_PHONE=
BUSINESS_SUPPORT_EMAIL=
BUSINESS_WEBSITE=
# SAC for physical well-being services; confirm with your accountant
INVOICE_SAC_CODE=999723
INVOICE_PREFIX=SKSL

# Session
# true on an HTTPS server (forced on in production); false only for local HTTP development
SESSION_SECURE=true

# Booking Rules (confirmed values only — do not invent pending decisions)
BOOKING_HOLD_MINUTES=10
FACILITY_OPEN=06:00
FACILITY_CLOSE=21:00
# Latest time a session may START (sessions must still end by FACILITY_CLOSE)
FACILITY_LAST_SLOT=20:00
GST_RATE=18

# Buffer (leave as 0 until client confirms — see PENDING_CLIENT_DECISIONS.md)
CHECKIN_BUFFER_MINUTES=0
CHECKOUT_BUFFER_MINUTES=0

# Advance booking window: how many days ahead a session can be booked.
# Used by the date picker, the availability API and the hold endpoint alike.
ADVANCE_BOOKING_DAYS=30

# Same-day cutoff: a slot starting today can only be booked if it starts at
# least this many minutes from now (0 = any slot that has not started yet).
SAME_DAY_CUTOFF_MINUTES=0

# Simultaneous unpaid holds one customer may keep open (each blocks capacity
# for BOOKING_HOLD_MINUTES).
MAX_ACTIVE_HOLDS_PER_USER=3
# Upcoming free professional appointments one account may hold at once
MAX_ACTIVE_PROFESSIONAL_BOOKINGS=3

# Unpaid "pending" bookings older than this are marked expired by
# cron/expire-holds.php and by the admin bookings page (default hold + 30).
PENDING_BOOKING_EXPIRY_MINUTES=40

# /health returns only {"success","status"} publicly. Set a long random token to
# receive env/db details with the header  X-Health-Token: <token>  — for uptime monitors.
HEALTH_CHECK_TOKEN=

# /.well-known/security.txt (RFC 9116) contact for vulnerability reports.
# Falls back to BUSINESS_SUPPORT_EMAIL; the file is not served when both are empty.
SECURITY_CONTACT_EMAIL=

# Uploads
UPLOAD_MAX_SIZE_BYTES=5242880

# Customer cancellation: a customer may cancel a confirmed session from My Sessions up to this many
# hours before it starts. Paid-online bookings keep CANCELLATION_FEE_PERCENT of the amount paid
# (incl. GST); SKSL refunds the rest manually.
CANCELLATION_NOTICE_HOURS=24
CANCELLATION_FEE_PERCENT=10

# Offline payments. While the online gateway is not live, set ONLINE_PAYMENTS_ENABLED=false: customers
# request a booking / combo package, pay by UPI (or at the centre), and staff approve it in the admin
# once the money has arrived. Set it back to true to bring the Razorpay checkout back.
ONLINE_PAYMENTS_ENABLED=false
# How long a request keeps its slot while waiting for payment (never past OFFLINE_PAYMENT_CUTOFF_HOURS
# before the session starts).
OFFLINE_PAYMENT_HOLD_HOURS=24
OFFLINE_PAYMENT_CUTOFF_HOURS=2
# Shown to the customer on the "awaiting payment" page and in the email.
UPI_ID=
UPI_PAYEE_NAME=
# Backup QR picture inside public/ (e.g. images/upi-qr.jpg), shown only if the QR with the amount cannot be drawn
UPI_QR_IMAGE=
OFFLINE_PAYMENT_NOTE=
