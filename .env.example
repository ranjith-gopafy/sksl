# =============================================
# SKSL — Environment Configuration Template
# Copy this file to .env and fill in values.
# NEVER commit .env to Git.
# =============================================

# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/sksl/public
APP_TIMEZONE=Asia/Kolkata
APP_SECRET=change-this-to-a-random-secret-string

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sksl
DB_USERNAME=root
DB_PASSWORD=

# Razorpay
# Use test credentials locally. Use production only after go-live approval.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SKSL

# Admin notification email
ADMIN_EMAIL=

# Session
# Set to false for local HTTP development; true in HTTPS production
SESSION_SECURE=false

# Booking Rules (confirmed values only — do not invent pending decisions)
BOOKING_HOLD_MINUTES=10
FACILITY_OPEN=06:00
FACILITY_CLOSE=22:00
GST_RATE=18

# Buffer (leave as 0 until client confirms — see PENDING_CLIENT_DECISIONS.md)
CHECKIN_BUFFER_MINUTES=0
CHECKOUT_BUFFER_MINUTES=0

# Advance booking window (days) — leave blank until client confirms
# ADVANCE_BOOKING_DAYS=

# Same-day cutoff (minutes before slot) — leave blank until client confirms
# SAME_DAY_CUTOFF_MINUTES=

# Uploads
UPLOAD_MAX_SIZE_BYTES=5242880
